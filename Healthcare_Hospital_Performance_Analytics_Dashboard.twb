      <column caption='Satisfaction Band' datatype='string' name='[Calculation_1548983363076096]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Patient_Satisfaction] &lt; 2.5 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Patient_Satisfaction] &lt; 3.5 THEN &quot;Average&quot;&#13;&#10;ELSEIF [Patient_Satisfaction] &lt; 4.5 THEN &quot;Good&quot;&#13;&#10;ELSE &quot;Excellent&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1753767049990144]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Age] &lt;= 18 THEN &quot;0-18&quot;&#13;&#10;ELSEIF [Age] &lt;= 30 THEN &quot;19-30&quot;&#13;&#10;ELSEIF [Age] &lt;= 45 THEN &quot;31-45&quot;&#13;&#10;ELSEIF [Age] &lt;= 60 THEN &quot;46-60&quot;&#13;&#10;ELSE &quot;60+&quot;&#13;&#10;END' />
      </column>
      <column caption='Readmission Flag' datatype='integer' name='[Calculation_1753767070724097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Readmission] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
